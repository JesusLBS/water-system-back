							"event": [
								{
									"listen": "test",
									"script": {
										"id": "be284b26-67d9-4bd2-9945-cb11a95b36d3",
										"exec": [
											"// Safe JSON parse",
											"let responseJson = {};",
											"try {",
											"    responseJson = pm.response.json();",
											"} catch (e) {",
											"    console.error(\"Invalid JSON response\");",
											"}",
											"",
											"// Status code test",
											"pm.test(\"Status code is 200\", function () {",
											"    pm.response.to.have.status(200);",
											"});",
											"",
											"// Validate structure safely",
											"pm.test(\"Response has valid token\", function () {",
											"    pm.expect(responseJson).to.be.an(\"object\");",
											"    pm.expect(responseJson).to.have.property(\"data\");",
											"    pm.expect(responseJson.data).to.have.property(\"token\");",
											"    pm.expect(responseJson.data.token).to.be.a(\"string\").and.not.empty;",
											"});",
											"",
											"// Only set token if it exists",
											"if (responseJson?.data?.token) {",
											"    pm.environment.set(\"bearerToken\", responseJson.data.token);",
											"} else {",
											"    console.error(\"Token not found in response\");",
											"}"
										],
										"type": "text/javascript",
										"packages": {},
										"requests": {}
									}
								}
